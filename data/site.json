  "faq": [
    {
      "q": {
        "zh": "起订量（MOQ）是多少？",
        "en": "What is the minimum order quantity (MOQ)?",
        "id": "Berapa minimal order (MOQ)?"
      },
      "a": {
        "zh": "支持混批。每款产品页标注了装箱量（pcs/件），一般按箱起订；具体以报价为准。",
        "en": "Mixed wholesale is supported. Each product page shows packing qty (pcs/ctn); usually ordered by carton. Confirm in quotation.",
        "id": "Grosir campuran didukung. Setiap produk mencantumkan jumlah per karton (pcs/karton); biasanya order per karton. Konfirmasi saat penawaran."
      }
    },
    {
      "q": {
        "zh": "价格包含运费吗？",
        "en": "Does the price include shipping?",
        "id": "Apakah harga sudah termasuk ongkir?"
      },
      "a": {
        "zh": "价格为批发参考价，不含运费。运费按收货地址和货物体积计算，报价时一并告知。",
        "en": "Prices are wholesale reference and exclude shipping. Freight is calculated by destination and volume, quoted together.",
        "id": "Harga grosir referensi, belum termasuk ongkir. Ongkir dihitung berdasarkan alamat dan volume, disampaikan saat penawaran."
      }
    },
    {
      "q": {
        "zh": "如何下单？",
        "en": "How do I place an order?",
        "id": "Bagaimana cara order?"
      },
      "a": {
        "zh": "WhatsApp 发送产品清单 → 我们报价 → 您确认并转账 → 发货。全程 WhatsApp 沟通。",
        "en": "Send product list via WhatsApp → get quotation → confirm & pay → ship. All via WhatsApp.",
        "id": "Kirim daftar produk via WhatsApp → dapat penawaran → konfirmasi & bayar → barang dikirim. Semua via WhatsApp."
      }
    },
    {
      "q": {
        "zh": "支持一件代发（Dropship）吗？",
        "en": "Do you support dropship?",
        "id": "Apakah mendukung dropship?"
      },
      "a": {
        "zh": "支持。可以提供无品牌包装图片和代发服务，适合电商卖家。",
        "en": "Yes. Neutral packaging and dropship service available for e-commerce sellers.",
        "id": "Ya. Tersedia kemasan netral dan layanan dropship untuk penjual online."
      }
    },
    {
      "q": {
        "zh": "现货多久发货？",
        "en": "How fast is ready stock shipped?",
        "id": "Seberapa cepat ready stock dikirim?"
      },
      "a": {
        "zh": "现货订单付款确认后当天或次日从雅加达仓库发出；预订单货期在报价时说明。",
        "en": "Ready stock ships same-day or next-day after payment confirmation from Jakarta. Pre-order lead time stated in quotation.",
        "id": "Ready stock dikirim hari ini atau besok setelah pembayaran dikonfirmasi dari Jakarta. Pre-order dijelaskan saat penawaran."
      }
    },
    {
      "q": {
        "zh": "支持哪些付款方式？",
        "en": "What payment methods do you accept?",
        "id": "Metode pembayaran apa saja?"
      },
      "a": {
        "zh": "银行转账（印尼本地银行账户）。具体账户信息在确认订单时提供。",
        "en": "Bank transfer to local Indonesian bank account. Account details provided on order confirmation.",
        "id": "Transfer bank ke rekening lokal Indonesia. Detail rekening diberikan saat konfirmasi pesanan."
      }
    }
  ],
